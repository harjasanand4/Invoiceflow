# Copy to .env and fill in. Never commit .env.

# Database. Defaults to a local SQLite file if unset.
# DATABASE_URL=postgresql+psycopg://invoiceflow:invoiceflow@localhost:5432/invoiceflow

# Extraction: rules (free, offline) | llm | hybrid (rules first, LLM only when needed)
EXTRACTOR=rules

# Which LLM: anthropic (paid) | gemini (free tier, small daily limit) | groq (free tier, ~1,000/day)
#            | openai_compatible (OpenRouter, a local Ollama model, ...)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPATIBLE_MODEL=qwen2.5:7b
# OPENAI_COMPATIBLE_API_KEY=

# Minimum seconds between LLM calls (0 = no limit). Free tiers allow only a few requests
# per minute: 6 keeps you under 10/minute. Rate-limit errors are also retried automatically.
LLM_MIN_INTERVAL_SECONDS=0

# Any field read with lower confidence than this goes to human review.
REVIEW_CONFIDENCE_THRESHOLD=0.85
MAX_ATTEMPTS=3

# true: process during upload (simple dev setup). false: the worker processes the queue.
PROCESS_ON_UPLOAD=true

# File storage: local | s3
STORAGE_BACKEND=local
# S3_BUCKET=
# S3_PREFIX=documents/

# Password-protect the app. Set both before exposing it to the internet.
# BASIC_AUTH_USER=
# BASIC_AUTH_PASSWORD=
